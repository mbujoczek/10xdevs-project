# OpenRouter API Key
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Database SA Password
# Strong password for SQL Server SA account (minimum 8 characters, including uppercase, lowercase, numbers, and symbols)
DB_SA_PASSWORD=

# JWT Secret Key
# Secret key for signing JWT tokens (minimum 32 characters for production use)
JWT_SECRET_KEY=
